{
  "name": "elmanasa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "منصة أكاديمية لكلية الهندسة - جامعة المنوفية",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "seed:demo": "node --env-file-if-exists=.env server/seed.js --demo"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "libsql": "^0.5.29",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
